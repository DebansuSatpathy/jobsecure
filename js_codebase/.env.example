# Copy this file to .env and fill values before running the server
# SMTP server settings (for example: Gmail SMTP or other provider)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_smtp_user@example.com
SMTP_PASS=your_smtp_password

# Optional: from and to addresses
FROM_EMAIL=your_from@example.com
TO_EMAIL=your_to@example.com

# Server port (optional)
PORT=4000
